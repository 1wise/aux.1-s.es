[Unit]
Description=TECH rescue consent and local controls
ConditionKernelCommandLine=aux.assist
Wants=NetworkManager.service
After=NetworkManager.service tech-work.service
Requires=tech-work.service
Conflicts=getty@tty6.service

[Service]
Type=simple
# Persistent NetworkManager state can leave networking or Wi-Fi disabled across boots.
ExecStartPre=/usr/bin/nmcli networking on
ExecStartPre=-/usr/bin/nmcli radio wifi on
# Keep local recovery available when no network can be established.
ExecStartPre=-/usr/bin/nm-online --quiet --timeout=15
ExecStartPre=/usr/bin/chvt 6
ExecStart=/usr/bin/python3 /usr/share/aux-assist/assist.py
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty6
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux
Environment=HOME=/root
UMask=0077
KillMode=control-group
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
