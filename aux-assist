"""Open physical VT6 controls without enabling an automatic login service."""
import os
import subprocess
import sys


def main():
    if os.geteuid() != 0:
        sys.exit('Ejecutar con sudo o desde el lanzador de escritorio autorizado.')
    res = subprocess.run(['who'], text=True, capture_output=True, check=True)
    if any(len(lin.split()) > 1 and lin.split()[1] == 'tty6' for lin in res.stdout.splitlines()):
        sys.exit('VT6 tiene una sesión de usuario; cerrar esa sesión antes de abrir AUX Assist.')
    subprocess.run(['systemctl', 'start', 'aux-assist.service'], check=True)
    subprocess.run(['chvt', '6'], check=True)


if __name__ == '__main__':
    main()
