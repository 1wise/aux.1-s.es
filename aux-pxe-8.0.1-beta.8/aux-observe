"""Open AUX observation tools without changing the host or fleet by default."""
import subprocess
from auxlib.observe import main

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        raise SystemExit('AUX OBSERVE: ' + str(exc))
