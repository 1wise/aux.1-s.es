"""Open the integrated AUX workspace or its physical-console tools."""
import sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parent))
from auxlib.localtools import main
if __name__=='__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (ValueError,OSError,RuntimeError) as exc:
        sys.exit('AUX detenido: '+str(exc))
