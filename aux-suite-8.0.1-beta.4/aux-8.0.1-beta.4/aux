"""Open the unified AUX menu while retaining each independent application."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from auxlib.hub import main

if __name__ == '__main__':
    try:
        
        if len(sys.argv)>1 and sys.argv[1]=='kernel-modeler':
            from auxlib.setup import main as kernel_main
            sys.exit(kernel_main(['--mode','kernel-modeler',*sys.argv[2:]]))
        if len(sys.argv)>1 and sys.argv[1] in ('evolve','self-assamble'):
            from auxlib.evolve import main as evolve_main
            sys.exit(evolve_main(sys.argv[2:]))
        if len(sys.argv)>1 and sys.argv[1] in ('catalog','download','deploy','generate','checkstatus'):
            from auxlib.v8 import main as task_main
            sys.exit(task_main())
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, RuntimeError) as exc:
        sys.exit('AUX detenido: ' + str(exc))
