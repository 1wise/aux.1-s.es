#!ipxe
# Timestamp: 2026-11-23 | Version: 8.0.1-beta.3
# Author & Credits: https://www.alawise.es/1-s
# iPXE commands: https://ipxe.org
# Required local files checked; hardware boot tests are separate.
cpair --foreground 2 --background 0 0 || goto colour_missing
# Firmware text consoles require basic ANSI; RGB parameters reset some BIOS/EFI attributes.
colour --basic 0 0 ||
colour --basic 1 1 ||
colour --basic 2 2 ||
colour --basic 4 4 ||
colour --basic 6 6 ||
cpair --foreground 2 --background 0 0 ||
cpair --foreground 4 --background 0 1 ||
cpair --foreground 4 --background 0 2 ||
cpair --foreground 4 --background 0 3 ||
cpair --foreground 4 --background 0 4 ||
cpair --foreground 1 --background 0 5 ||
cpair --foreground 1 --background 0 6 ||
cpair --foreground 4 --background 0 7 ||
cpair --foreground 2 --background 0 0 && console --keep || goto colour_missing
goto colour_ready
:colour_missing
echo Colour support unavailable. Rebuild the USB with CONSOLE_CMD enabled.
:colour_ready
set menu_back start
set cpu_arch ${buildarch}
iseq ${buildarch} i386 && cpuid --ext 29 && set cpu_arch x86_64 ||
set menu_arch ${cpu_arch}
set auto_timeout 0
set auto_target nav_assistance
clear auto_label ||
isset ${ip} || dhcp || goto error
:start
set menu_back start
cpair --foreground 2 --background 0 0 ||
menu WAN Arsenal / iPXE / pxe.1-s.es / ${menu_arch}
item --key 0 nav_assistance 0. Remote assistance
isset ${auto_label} && item ${auto_target} 0.0. Start assistance / ${auto_label} ||
isset ${auto_label} || item --gap -- No two-terminal Live declared / select legacy media manually.
item --key 1 nav_distribution 1. Distros
item --key 2 nav_tools 2. Tools
item origin_menu 3. Systems and tools / full origin catalogue
item --gap --
item arch_menu Architecture: ${menu_arch} / firmware: ${platform}
item boards ARM boards / U-Boot
item cloud_info Cloud images / VM
item shell Open iPXE shell
item reboot Reboot
item exit Boot local disk
choose --default ${auto_target} --timeout ${auto_timeout} --retimeout 0 target || goto cancelled
set auto_timeout 0
goto ${target}
:cancelled
set auto_timeout 0
goto start

:nav_assistance
set menu_back nav_assistance
menu Remote assistance
set menu_items 0
iseq ${menu_items} 0 && item --gap -- No compatible complete boot recipe in this branch. ||
item --gap -- Downloads and image files: https://aux.1-s.es/
item --gap --
item start Back
item shell Open iPXE shell
choose target && goto ${target} || goto start

