:origin_provider
set aux_origin_back origin_menu
set arch ${menu_arch}
clear menu
chain --autofree https://boot.netboot.xyz || goto origin_error
goto origin_menu
:origin_error
echo Upstream menu failed. Check network, HTTPS support and firmware.
prompt Press any key to return...
goto ${aux_origin_back}

:arch_menu
set auto_timeout 0
menu Architecture / compatible boot targets
item arch_auto Auto / ${cpu_arch}
iseq ${buildarch} i386 && item arch_i386 i386 / 32-bit PC ||
iseq ${cpu_arch} x86_64 && item arch_x86_64 x86_64 / 64-bit PC ||
iseq ${cpu_arch} arm64 && item arch_arm64 ARM64 / AArch64 ||
item start Back
choose target && goto ${target} || goto start
:arch_auto
set menu_arch ${cpu_arch}
goto start
:arch_i386
set menu_arch i386
goto start
:arch_x86_64
set menu_arch x86_64
goto start
:arch_arm64
set menu_arch arm64
goto start
:boards
set auto_timeout 0
echo U-Boot is board-specific firmware, not a universal ISO.
echo Guide: https://aux.1-s.es/architectures.html#uboot
prompt Press any key...
goto start
:cloud_info
set auto_timeout 0
echo Debian and Fedora: netinstall for installation; QCOW2 for VM import.
echo Downloads: https://aux.1-s.es/architectures.html#cloud
prompt Press any key...
goto start
:incompatible
set auto_timeout 0
echo Incompatible CPU or firmware.
prompt Press any key...
goto start

:shell
shell
goto ${menu_back}
:reboot
reboot
:exit
exit
:error
set auto_timeout 0
cpair --foreground 1 --background 0 0 ||
echo Boot failed. Check the HTTP paths, payload files and client firmware.
prompt Press any key to return...
cpair --foreground 2 --background 0 0 ||
goto ${menu_back}
