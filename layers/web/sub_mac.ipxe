#!ipxe
# Timestamp: 2026-11-28 | Version: 8.0.1-beta.9
# Author & Credits: https://www.alawise.es/1-s
:start
menu AUX / macOS / recovery
iseq ${buildarch} x86_64 && iseq ${platform} efi && item opencore-1.0.8 OpenCore / Intel EFI ||
iseq ${buildarch} x86_64 && iseq ${platform} efi && item macos-26-tahoe Tahoe Recovery / Intel EFI ||
iseq ${buildarch} x86_64 && iseq ${platform} efi && item macos-15-sequoia Sequoia Recovery / Intel EFI ||
item macos-27-goldengate Apple Silicon / Recovery information
item back Return
choose --default back choice || goto back
goto ${choice}
:opencore-1.0.8
isset ${aux_mac_root} || set aux_mac_root media/macos
imgfree
chain --autofree ${aux_mac_root}/opencore-1.0.8/EFI/OC/OpenCore.efi || goto error
goto start
:macos-26-tahoe
isset ${aux_mac_root} || set aux_mac_root media/macos
imgfree
sanboot --no-describe --drive 0x80 ${aux_mac_root}/macos-26-tahoe/tahoe-recovery-oc108.img || goto error
goto start
:macos-15-sequoia
isset ${aux_mac_root} || set aux_mac_root media/macos
imgfree
sanboot --no-describe --drive 0x80 ${aux_mac_root}/macos-15-sequoia/sequoia-recovery-oc108.img || goto error
goto start
:macos-27-goldengate
echo Apple Silicon: start in macOS Recovery using startup options.
echo https://support.apple.com/en-us/102655
prompt Press a key to return...
goto start
:error
imgfree
echo Check local media paths and firmware compatibility.
prompt Press a key to return...
goto start
:back
exit 0
