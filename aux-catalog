"""Open the canonical AUX 8 catalogue."""
import sys
from auxlib.v8 import main
if __name__ == '__main__':
    try:
        raise SystemExit(main(['catalog', *sys.argv[1:]]))
    except (ValueError, OSError) as exc:
        raise SystemExit('Catalogo: '+str(exc))
