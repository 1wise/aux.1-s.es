"""Configure AUX paths, public hosts, budgets and private credentials."""
import argparse
import getpass
import json
import sys
from auxlib import settings as cfg, VERSION
from auxlib.console_ui import aplicacion, campo
from auxlib.interactive import elige


def menu(pth, sec):
    grupos = {
        'osquery / osctrl':['observe.api_url','observe.environment','observe.limit','observe.ca_file','osctrl_api_token'],
        'INPUT / OUTPUT y catálogos':['output','cache','ram_dir','catalog_file','catalog_profile','checksums',
                                    'url_file','light_url_file','heavy_url_file','catalog_sources_file','mirror.source_root','mirror.state_root','mirror.release_id','mirror.minimum_isos'],
        'Dominios AUX / PXE / TEC':[n for n in cfg.CAMPOS if n.startswith(('targets.','bastion.'))],
        'Réplica rsync / SSH':[n for n in cfg.CAMPOS if n.startswith('mirror.ssh_')]+['mirror.transport','mirror.remote_root','ssh_password'],
        'FTPS alternativo':['ftp_host','ftp_user','ftp_port','ftp_root','ftp_tls','ftp_password'],
        'GPT / Gemini':['ai.enabled','ai.openai.model','ai.gemini.model','openai_api_key','gemini_api_key'],
        'Inventario Bastion':['checkstatus.bastion.enabled','checkstatus.bastion.transport','checkstatus.bastion.directories','checkstatus.bastion.fallback_ftp','checkstatus.max_age_seconds'],
        'Presupuestos RAM / SSD':['ram_budget_gib','ram_reserve_percent','ssd_budget_gib','presets.preset_ram_gib','presets.preset_ssd_gib','jobs'],
    }
    with aplicacion('AUX CONFIG '+VERSION+' | Settings','configuracion'):
        while True:
            try:
                grp = elige('Configuración central',[(k,k) for k in grupos]+[('Diagnóstico','doctor'),('Volver','back')])
                if grp == 'back': return 0
                if grp == 'doctor':
                    campo('Diagnóstico local',resumen=json.dumps(cfg.diagnostico(pth,sec),ensure_ascii=False,indent=2).splitlines())
                    continue
                if grp == 'Inventario Bastion':
                    from auxlib.bastion_status import configura
                    configura(pth,sec);continue
                nom = elige(grp,[(n,n) for n in grupos[grp]]+[('Volver',None)])
                if nom is None: continue
                if nom in cfg.SECRETOS:
                    val = getpass.getpass(nom+' (entrada oculta; vacío elimina): ')
                    cfg.guarda_secreto(nom,val,sec,pth)
                else:
                    val = cfg.valor(cfg.lee_config(pth),nom,'')
                    txt = json.dumps(val,ensure_ascii=False) if isinstance(val,list) and nom.endswith('directories') else ','.join(val) if isinstance(val,list) else str(val) if val is not None else ''
                    cfg.establece(nom,campo(nom,txt,validar=lambda val: cfg.convierte(nom,val)),pth)
            except KeyboardInterrupt: return 0
            except (ValueError,OSError) as err: campo('Configuración pendiente',resumen=[str(err)])


def main():
    par = argparse.ArgumentParser(description=__doc__)
    par.add_argument('--version',action='version',version='aux-config '+VERSION)
    par.add_argument('--config'); par.add_argument('--secrets')
    par.add_argument('-i','--interactive',action='store_true')
    sub = par.add_subparsers(dest='cmd')
    sub.add_parser('doctor'); sub.add_parser('show')
    ent = sub.add_parser('set'); ent.add_argument('field',choices=sorted(cfg.CAMPOS)); ent.add_argument('value')
    ent = sub.add_parser('secret'); ent.add_argument('name',choices=cfg.SECRETOS)
    ent = sub.add_parser('test-connection');ent.add_argument('transport',choices=['rsync','ftp'])
    arg = par.parse_args()
    if arg.interactive:
        if not sys.stdin.isatty(): par.error('Se requiere una terminal interactiva.')
        return menu(arg.config,arg.secrets)
    if arg.cmd == 'set': cfg.establece(arg.field,arg.value,arg.config)
    elif arg.cmd == 'secret':
        if not sys.stdin.isatty(): par.error('La clave requiere entrada oculta en terminal.')
        cfg.guarda_secreto(arg.name,getpass.getpass('Credencial (vacío elimina): '),arg.secrets,arg.config)
    elif arg.cmd == 'show': print(json.dumps(cfg.lee_config(arg.config),ensure_ascii=False,indent=2))
    elif arg.cmd == 'doctor': print(json.dumps(cfg.diagnostico(arg.config,arg.secrets),ensure_ascii=False,indent=2))
    elif arg.cmd == 'test-connection':
        from auxlib.bastion_status import prueba_conexion
        result=prueba_conexion(cfg.lee_config(arg.config),arg.transport,arg.config,arg.secrets)
        print(json.dumps(result,ensure_ascii=False,indent=2))
        return 0 if result.get('root_status','ok')=='ok' else 1
    else: par.print_help()
    return 0


if __name__ == '__main__':
    try: raise SystemExit(main())
    except KeyboardInterrupt: raise SystemExit(130)
    except (ValueError,OSError) as err: raise SystemExit('AUX CONFIG: '+str(err))
