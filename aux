"""Open the unified AUX menu while retaining each independent application."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from auxlib.hub import main

if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, RuntimeError) as exc:
        sys.exit('AUX detenido: ' + str(exc))
