[Unit]
Description=AUX local proposal broker (no remote approval)
After=aux-assist.service
Requires=aux-assist.service

[Service]
Type=simple
User=root
Group=aux-ai
ExecStart=/usr/bin/python3 /usr/local/lib/aux/assist/payload/aux_exec.py serve
RuntimeDirectory=aux-exec
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/aux-exec
CapabilityBoundingSet=CAP_CHOWN
# Only the root approval console performs actions; this daemon only stores proposals.


